# Версия для примера — скопируйте в .env и заполните реальными значениями.
# НЕ коммитьте реальный .env в репозиторий.

# Токен бота (обязателен) — от @BotFather
SPORT_BOT_TOKEN=ваш_токен_от_botfather

# Прокси (если нужен). Пусто = без прокси.
PROXY_URL=

# Rate limit (текстовые сообщения): N сообщений за T окно секунд
RATE_LIMIT_MESSAGES=30
RATE_LIMIT_WINDOW=60

# Администраторы (telegram-id через запятую). Если пусто — только 351572247.
ADMIN_IDS=351572247

# Время ежедневного напоминания (часы/минуты, локальное для REMINDER_TZ=Asia/Yekaterinburg)
REMINDER_HOUR=20
REMINDER_MINUTE=0

# Ключ шифрования персональных данных (минимум 32 символа!)
# Если не задан — шифрование ПД отключено (данные хранятся открыто).
ENCRYPTION_KEY=
